# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# CurseForge AUTHORS API token — uploads, game-version lists.
# https://authors-old.curseforge.com/account/api-tokens  (UUID format)
CURSEFORGE_API_KEY=

# CurseForge ETERNAL / Core API key — mod search & browse (top-mods list).
# https://console.curseforge.com/ -> API Keys  (long $2a$10$... bcrypt string)
CURSEFORGE_ETERNAL_API_KEY=

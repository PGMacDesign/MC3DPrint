---
import Base from "../layouts/Base.astro";
---
<Base title="Submit a Build — MC3DPrint" description="Share a build you made. Drag in your .blueprint file, preview it in 3D, and submit it for review — no GitHub account or coding required.">
  <!-- three.js for the live preview, same versions the viewer uses -->
  <script is:inline type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
  </script>

  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">Contribute</span>
      <h1>Share a build with the community.</h1>
      <p class="lede">
        Made something worth shipping? Drag in your <code>.blueprint</code> file,
        check the 3D preview, add your name for credit, and submit. <strong>No GitHub
        account. No coding.</strong> If it's a good fit, it gets added to the mod for everyone.
      </p>

      <ol class="how-mini">
        <li><strong>1.</strong> Drop your file</li>
        <li><strong>2.</strong> Preview &amp; describe it</li>
        <li><strong>3.</strong> Submit for review</li>
      </ol>

      <!-- dropzone -->
      <label id="drop" class="drop" for="file">
        <input id="file" type="file" accept=".blueprint" hidden />
        <div class="drop-inner">
          <span class="drop-icon">⬇</span>
          <strong>Drag your .blueprint here</strong>
          <span class="muted">or click to choose a file</span>
        </div>
      </label>

      <!-- preview + form (hidden until a file loads) -->
      <div id="stage" hidden>
        <div class="preview-wrap">
          <canvas id="canvas"></canvas>
          <div id="stats" class="stats"></div>
        </div>

        <form id="form" class="form">
          <label>Build name
            <input id="bname" name="name" type="text" required maxlength="60" />
          </label>
          <label>Your name or handle <span class="muted">(for credit)</span>
            <input id="author" name="author" type="text" required maxlength="40" placeholder="e.g. Steve, or @yourhandle" />
          </label>
          <label>Description <span class="muted">(optional)</span>
            <textarea id="desc" name="description" rows="3" maxlength="500" placeholder="What is it? Anything reviewers should know?"></textarea>
          </label>
          <label class="check">
            <input id="rights" type="checkbox" required />
            <span>I made this build (or have the right to share it) and I'm okay with it being included in MC3DPrint under the project's MIT license.</span>
          </label>

          <div id="turnstile"></div>
          <button id="send" class="btn btn-primary" type="submit">Submit for review</button>
          <p id="msg" class="msg" hidden></p>
        </form>
      </div>

      <div class="note card">
        <h3>What happens next?</h3>
        <p class="muted">
          Your file and notes open a pull request on GitHub, where it's automatically
          rendered and reviewed. Being submitted doesn't guarantee inclusion — accepted
          builds need a little integration work before they ship — but every submission
          is looked at. You'll be credited if it lands.
        </p>
      </div>
    </div>
  </section>
</Base>

<script is:inline type="module">
  import pako from "https://cdn.jsdelivr.net/npm/pako@2.1.0/+esm";
  import { parseNbt } from "/viewer/js/nbt.js";
  import { decodeBlueprint } from "/viewer/js/blueprint.js";
  import { loadColorTable, isUnknown } from "/viewer/js/colors.js";
  import { Viewer } from "/viewer/js/viewer.js";

  // Set this once the Cloudflare Worker is deployed (its *.workers.dev URL).
  const SUBMIT_ENDPOINT = "https://mc3dprint-submit.patrick-4bc.workers.dev";
  // Optional Cloudflare Turnstile site key. When set, a captcha is shown and its
  // token is sent with the submission (the Worker must also have TURNSTILE_SECRET).
  const TURNSTILE_SITEKEY = "";
  let turnstileToken = "";

  if (TURNSTILE_SITEKEY) {
    window.onTurnstile = (t) => { turnstileToken = t; };
    const s = document.createElement("script");
    s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
    s.async = true; s.defer = true;
    document.head.appendChild(s);
    s.onload = () => window.turnstile?.render("#turnstile", { sitekey: TURNSTILE_SITEKEY, callback: window.onTurnstile });
  }

  const MAX_COMPRESSED = 8 * 1024 * 1024;
  const TIER_FOOTPRINT = [[3, 3], [4, 5], [5, 9], [6, 15], [7, 33], [8, 51]];
  const tierFor = (sx, sz) => { const e = Math.max(sx, sz); for (const [t, c] of TIER_FOOTPRINT) if (e <= c) return t; return 9; };

  const $ = (id) => document.getElementById(id);
  await loadColorTable("/viewer/data/block_colors.json");

  let viewer = null;
  let fileBytes = null;
  let detected = null;

  function showStage(bp, bytes) {
    fileBytes = bytes;
    detected = bp;
    $("stage").hidden = false;
    if (!viewer) viewer = new Viewer($("canvas"));
    viewer.load(bp);

    const tier = tierFor(bp.sx, bp.sz);
    const unknown = new Set();
    for (const p of bp.palette) if (isUnknown(p.id)) unknown.add(p.id);
    const rows = [
      ["Size", `${bp.sx} × ${bp.sy} × ${bp.sz}`],
      ["Blocks", bp.blockCount.toLocaleString()],
      ["Min tier", tier > 8 ? "too large to print" : `T${tier} printer`],
    ];
    if (unknown.size) rows.push(["Unknown blocks", `${unknown.size} (shown magenta)`]);
    $("stats").innerHTML = rows.map(([k, v]) => `<div><span>${k}</span><b>${v}</b></div>`).join("");

    if (!$("bname").value) $("bname").value = bp.name && bp.name !== "" ? bp.name : "";
  }

  function handle(bytes, label) {
    try {
      if (bytes.length > MAX_COMPRESSED) throw new Error("file is too large (max 8 MB)");
      const bp = decodeBlueprint(parseNbt(pako.ungzip(bytes)));
      showStage(bp, bytes);
    } catch (e) {
      alert(`Couldn't read ${label || "that file"}: ${e.message}\n\nMake sure it's a .blueprint exported from MC3DPrint.`);
    }
  }

  $("file").addEventListener("change", async (e) => {
    const f = e.target.files[0];
    if (f) handle(new Uint8Array(await f.arrayBuffer()), f.name);
  });

  const drop = $("drop");
  ["dragover", "dragenter"].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add("over"); }));
  ["dragleave", "drop"].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove("over")));
  drop.addEventListener("drop", async (e) => {
    e.preventDefault();
    const f = e.dataTransfer.files[0];
    if (f) handle(new Uint8Array(await f.arrayBuffer()), f.name);
  });

  $("form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = $("msg");
    if (!fileBytes) return;

    if (!SUBMIT_ENDPOINT) {
      msg.hidden = false;
      msg.className = "msg info";
      msg.textContent = "Preview works! Submissions go live the moment the upload service is connected — check back soon.";
      return;
    }

    const btn = $("send");
    btn.disabled = true;
    msg.hidden = true;
    try {
      if (TURNSTILE_SITEKEY && !turnstileToken) {
        msg.hidden = false; msg.className = "msg err"; msg.textContent = "Please complete the captcha first.";
        return;
      }
      // Chunk the base64 encode so a large file doesn't blow the call stack.
      let bin = "";
      for (let i = 0; i < fileBytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, fileBytes.subarray(i, i + 0x8000));
      const body = {
        name: $("bname").value.trim(),
        author: $("author").value.trim(),
        description: $("desc").value.trim(),
        detected: { sx: detected.sx, sy: detected.sy, sz: detected.sz, blocks: detected.blockCount, tier: tierFor(detected.sx, detected.sz) },
        turnstileToken,
        file: btoa(bin),
      };
      const res = await fetch(SUBMIT_ENDPOINT, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      if (!res.ok) throw new Error(`server returned ${res.status}`);
      const out = await res.json();
      msg.hidden = false;
      msg.className = "msg ok";
      msg.innerHTML = out.url ? `Thanks! Your build was submitted — <a href="${out.url}" target="_blank" rel="noopener">track it here</a>.` : "Thanks! Your build was submitted for review.";
      $("form").reset();
    } catch (err) {
      msg.hidden = false;
      msg.className = "msg err";
      msg.textContent = `Something went wrong: ${err.message}. Please try again.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .narrow { max-width: 820px; }
  .how-mini { display: flex; gap: 1.5rem; list-style: none; padding: 0; margin: 1.4rem 0; flex-wrap: wrap; color: var(--ink-soft); }
  .how-mini strong { color: var(--filament); }

  .drop {
    display: block; border: 2px dashed var(--line); border-radius: var(--radius);
    background: var(--panel); padding: 2.4rem; text-align: center; cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .drop:hover, .drop.over { border-color: var(--filament); background: color-mix(in srgb, var(--filament) 7%, var(--panel)); }
  .drop-inner { display: grid; gap: 0.3rem; justify-items: center; }
  .drop-icon { font-size: 1.8rem; color: var(--filament); }

  .preview-wrap { margin: 1.6rem 0; display: grid; grid-template-columns: 1fr 220px; gap: 1rem; }
  #canvas { width: 100%; height: 320px; background: #1b1e23; border: 1px solid var(--line); border-radius: var(--radius); display: block; }
  .stats { display: grid; gap: 0.5rem; align-content: start; }
  .stats div { display: flex; justify-content: space-between; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem 0.7rem; font-size: 0.88rem; }
  .stats span { color: var(--ink-faint); }
  .stats b { color: var(--ink); }

  .form { display: grid; gap: 1rem; margin-top: 0.5rem; }
  .form label { display: grid; gap: 0.35rem; font-weight: 500; font-size: 0.95rem; }
  .form input[type="text"], .form textarea {
    font: inherit; color: var(--ink); background: var(--panel);
    border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem;
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--filament); }
  .check { grid-template-columns: auto 1fr; align-items: start; gap: 0.6rem; font-weight: 400; color: var(--ink-soft); font-size: 0.9rem; }
  .check input { margin-top: 0.2rem; }
  #send { justify-self: start; }

  .msg { padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); font-size: 0.92rem; margin: 0; }
  .msg.info { background: color-mix(in srgb, var(--teal) 12%, var(--panel)); border: 1px solid var(--teal); color: var(--teal-hi); }
  .msg.ok { background: color-mix(in srgb, #6fd07a 12%, var(--panel)); border: 1px solid #6fd07a; }
  .msg.err { background: color-mix(in srgb, #ff5d6c 12%, var(--panel)); border: 1px solid #ff5d6c; }

  .note { margin-top: 2rem; }
  .note h3 { margin: 0 0 0.4rem; }
  .note p { margin: 0; }

  @media (max-width: 680px) { .preview-wrap { grid-template-columns: 1fr; } }
</style>

---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const CATEGORIES = [
  { key: "Basics", blurb: "Scan, disc, print, plus the Filament Unit economy that turns any material into any other of its tier." },
  { key: "Machines", blurb: "Printer tiers, upgrade modules, the rack, the cable, and the repository." },
  { key: "Multiblocks", blurb: "Assemble and form the T5–T8 fabricators that print at scale." },
  { key: "Resins", blurb: "One-shot additives that make a print come out finer — not just bigger." },
];

const entries = await getCollection("guide");
const byCat = (key) =>
  entries.filter((e) => e.data.category === key).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Guide — MC3DPrint"
  description="Tutorials for every part of MC3DPrint: scanning, printing, converting materials in Item Mode, the Filament Unit economy, printer tiers, upgrades, multiblock fabricators, and resins."
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Guide</span>
      <h1>Learn the mod, one system at a time.</h1>
      <p class="lede">
        From your first scan to printing an entire base with a multiblock fabricator.
        Prefer it in-game? MC3DPrint ships this same guide as an in-game
        <strong>Patchouli</strong> book (Patchouli optional).
      </p>

      {CATEGORIES.map((c) => (
        <div class="cat">
          <div class="cat-head">
            <h2>{c.key}</h2>
            <p class="muted">{c.blurb}</p>
          </div>
          <div class="grid topic-grid">
            {byCat(c.key).map((e) => (
              <a class="card topic" href={`/guide/${e.id}/`}>
                <span class="chip tag">{c.key}</span>
                <h3>{e.data.title}</h3>
                <p>{e.data.summary}</p>
                <span class="go">Read →</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="cat faq-cat">
        <div class="cat-head">
          <h2>FAQ</h2>
          <p class="muted">Why won't it print? How do I move the build? Auto vs manual? The quick answers.</p>
        </div>
        <a class="btn btn-ghost" href="/faq">Read the FAQ →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cat { margin-top: 2.6rem; }
  .cat-head h2 { margin: 0 0 0.2rem; }
  .cat-head p { margin: 0 0 1.1rem; max-width: 60ch; }
  .topic-grid { grid-template-columns: repeat(3, 1fr); }
  .topic { position: relative; display: flex; flex-direction: column; gap: 0.4rem; transition: transform 0.1s ease, border-color 0.15s ease; }
  .topic:hover { transform: translateY(-3px); border-color: var(--filament); text-decoration: none; }
  .topic h3 { margin: 0.5rem 0 0; }
  .topic p { margin: 0; font-size: 0.95rem; flex: 1; }
  .tag { color: var(--cyan); font-size: 0.7rem; align-self: flex-start; }
  .go { color: var(--filament-hi); font-size: 0.85rem; font-weight: 600; margin-top: 0.3rem; }
  .faq-cat .cat-head p { margin-bottom: 0.8rem; }
  @media (max-width: 980px) { .topic-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .topic-grid { grid-template-columns: 1fr; } }
</style>

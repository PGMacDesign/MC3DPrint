---
import Base from "../../layouts/Base.astro";

// Tutorial hub. Each topic will become its own page (or Markdown entry) as we
// flesh the content out; for now they're stubbed so the structure is visible.
const topics = [
  { t: "Scanning a build", d: "Craft and use the Structure Scanner to capture a structure to a Blueprint Disc.", tag: "Basics" },
  { t: "Printing", d: "Set up a printer, load a disc and a spool, supply power, and print.", tag: "Basics" },
  { t: "Filament Units & the economy", d: "How winding works, why printing is lossy, and how to reach break-even.", tag: "Economy" },
  { t: "Printer tiers T1–T8", d: "Footprint limits per tier and when to graduate to a multiblock fabricator.", tag: "Machines" },
  { t: "Upgrades", d: "Speed, efficiency, and capacity modules — slots scale with tier.", tag: "Machines" },
  { t: "Resins", d: "Per-print modifiers that grow crops, fill containers, and more.", tag: "Advanced" },
  { t: "Multiblock fabricators", d: "Assembling the T5–T8 N×N structures that print whole bases.", tag: "Machines" },
  { t: "The Blueprint Repository", d: "Cataloguing your discs and re-burning copies on demand.", tag: "Advanced" },
];
---
<Base title="Guide — MC3DPrint" description="Tutorials and walkthroughs for every part of MC3DPrint: scanning, printing, the Filament Unit economy, tiers, upgrades, and resins.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Guide</span>
      <h1>Learn the mod, one system at a time.</h1>
      <p class="lede">Walkthroughs for everything from your first scan to printing an entire base with a multiblock fabricator. Each guide has screenshots and step-by-step instructions.</p>

      <div class="grid topic-grid">
        {topics.map((t) => (
          <article class="card topic">
            <span class="chip tag">{t.tag}</span>
            <h3>{t.t}</h3>
            <p>{t.d}</p>
            <span class="soon muted">Coming soon</span>
          </article>
        ))}
      </div>

      <p class="muted" style="margin-top:1.5rem">
        Prefer it in-game? MC3DPrint ships a full <strong>Patchouli</strong> guide book too (Patchouli optional).
      </p>
    </div>
  </section>
</Base>

<style>
  .topic-grid { grid-template-columns: repeat(3, 1fr); margin-top: 1.8rem; }
  .topic { position: relative; }
  .topic h3 { margin: 0.6rem 0 0.4rem; }
  .topic p { margin: 0 0 0.8rem; font-size: 0.95rem; }
  .tag { color: var(--teal); font-size: 0.7rem; }
  .soon { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; }
  @media (max-width: 820px) { .topic-grid { grid-template-columns: 1fr; } }
</style>

---
import Base from "../layouts/Base.astro";
---
<Base title="Blueprint Gallery — MC3DPrint" description="Browse the curated builds that ship with MC3DPrint and preview each one in an interactive 3D viewer.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Gallery</span>
      <h1>Every build that ships with the mod.</h1>
      <p class="lede">These curated blueprints come bundled with MC3DPrint — ready to print in survival. Click any one to spin it around in the 3D viewer.</p>

      <div class="bar">
        <input id="q" type="search" placeholder="Search builds…" autocomplete="off" />
        <span id="count" class="muted"></span>
      </div>

      <div id="grid" class="grid card-grid"></div>
      <p id="empty" class="muted" hidden>No builds match that search.</p>
    </div>
  </section>
</Base>

<script>
  const tierColor = (t) => getComputedStyle(document.documentElement).getPropertyValue(`--t${t}`).trim() || "#aaa";
  const grid = document.getElementById("grid");
  const q = document.getElementById("q");
  const count = document.getElementById("count");
  const empty = document.getElementById("empty");
  let builds = [];
  let base = "/viewer/blueprints/";
  let credits = {}; // buildId -> [{author, file}, ...] (published screenshots, in order)

  function shotFor(id) {
    const list = (credits[id] || []).filter((e) => e && e.file);
    return list.length ? `/builds/${id}/${list[0].file}` : null;
  }

  function render(list) {
    grid.innerHTML = "";
    empty.hidden = list.length > 0;
    count.textContent = `${list.length} build${list.length === 1 ? "" : "s"}`;
    for (const b of list) {
      const id = b.file.replace(/\.blueprint$/, "");
      const tc = tierColor(b.tier);
      const shot = shotFor(id);
      const a = document.createElement("a");
      a.className = "card build";
      a.href = `/builds/${id}/`;
      a.innerHTML = `
        <div class="shot" style="--tc:${tc}">
          ${shot ? `<img src="${shot}" alt="" loading="lazy" onerror="this.remove()" />` : ""}
          <span class="glyph" aria-hidden="true">▦</span>
          ${shot ? "" : `<span class="wanted" title="Open this build to add a screenshot">📷 Screenshot wanted</span>`}
        </div>
        <div class="build-body">
          <div class="build-top">
            <span class="tier" style="color:${tc}">T${b.tier}</span>
            <span class="dims">${b.sx}×${b.sy}×${b.sz}</span>
          </div>
          <h3>${b.name}</h3>
          <p class="muted">${b.blocks.toLocaleString()} blocks</p>
        </div>`;
      grid.appendChild(a);
    }
  }

  function filter() {
    const term = q.value.trim().toLowerCase();
    render(term ? builds.filter((b) => b.name.toLowerCase().includes(term)) : builds);
  }

  // Credits are optional — if the file isn't there yet, every card just shows "wanted".
  Promise.all([
    fetch("/viewer/manifest.json").then((r) => { if (!r.ok) throw new Error(); return r.json(); }),
    fetch("/builds/credits.json").then((r) => (r.ok ? r.json() : { builds: {} })).catch(() => ({ builds: {} })),
  ])
    .then(([m, c]) => { builds = m.builds || []; base = m.base || base; credits = (c && c.builds) || {}; render(builds); })
    .catch(() => { count.textContent = "Gallery loads once the site is deployed."; });

  q.addEventListener("input", filter);
</script>

<style>
  .bar { display: flex; align-items: center; gap: 1rem; margin: 1.6rem 0 1.2rem; }
  #q {
    flex: 1; max-width: 420px; font: inherit; color: var(--ink);
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius-sm); padding: 0.6rem 0.9rem;
  }
  #q:focus { outline: none; border-color: var(--filament); }
  .card-grid { grid-template-columns: repeat(4, 1fr); }
  .build { padding: 0; overflow: hidden; transition: transform 0.1s ease, border-color 0.15s ease; }
  .build:hover { transform: translateY(-3px); border-color: var(--filament); text-decoration: none; }
  .shot {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden;
    display: grid; place-items: center;
    background: linear-gradient(160deg, color-mix(in srgb, var(--tc) 22%, var(--panel)), var(--bg-soft));
  }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .shot .glyph { font-size: 1.9rem; color: color-mix(in srgb, var(--tc) 70%, var(--ink-faint)); opacity: 0.5; }
  .wanted {
    position: absolute; bottom: 0.5rem; left: 0.5rem; z-index: 2;
    font-family: var(--mono); font-size: 0.68rem; font-weight: 600;
    padding: 0.2rem 0.45rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--filament) 20%, var(--bg-soft));
    border: 1px solid color-mix(in srgb, var(--filament) 45%, transparent);
    color: var(--ink-soft);
  }
  .build-body { padding: 0.85rem 1rem 1rem; }
  .build-top { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.78rem; }
  .tier { font-weight: 700; }
  .dims { color: var(--ink-faint); }
  .build h3 { margin: 0.5rem 0 0.2rem; font-size: 1.05rem; }
  .build p { margin: 0; font-size: 0.85rem; }
  @media (max-width: 980px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .card-grid { grid-template-columns: 1fr; } }
</style>

---
import Base from "../layouts/Base.astro";

const features = [
  { icon: "🧵", title: "Turn matter into matter", body: "Wind any material into Filament Units, then print anything else at that tier or below. Ten sculk becomes three diamonds. A spare elytra becomes four netherite ingots." },
  { icon: "📡", title: "Scan any build", body: "Point the Structure Scanner at anything you've built (every block, every state, every connection) and capture it to a Blueprint Disc." },
  { icon: "🖨️", title: "Print it anywhere", body: "Drop the disc in a printer, feed it power and filament, and watch your build reconstruct block by block, exactly as scanned." },
  { icon: "🏗️", title: "Tiers T1–T8", body: "Single-block printers for small builds, scaling up to N×N multiblock fabricators that lay down entire bases." },
  { icon: "💿", title: "Curated blueprints", body: "Ships with a library of ready-to-print builds (castles, farms, libraries) and you can re-burn copies whenever you like." },
  { icon: "🧪", title: "Resins & upgrades", body: "Modifiers that grow crops, fill chests, or speed the print. Slot in upgrades to tune speed, efficiency, and capacity, or to wire a machine's busy signal into redstone." },
];

const steps = [
  { n: "01", t: "Wind it in", d: "Feed any valued item into the Filament Winder. It becomes Filament Units denominated at that item's own tier." },
  { n: "02", t: "Pick a template", d: "Drop an item into the printer to make copies of it, or load a Blueprint Disc (scanned or found) to build a whole structure." },
  { n: "03", t: "Print it out", d: "Supply RF and let it run. A spool pays for any template at its own tier or below, so filament spends downward, never up." },
];

// Every ratio here is exact at 1:1 break-even, straight from the FU registry:
// 3×copper(10)=30=2×gold(15), 4×end_stone(5)=20=1×iron(20), 5×redstone(4)=20=
// 1×glowstone(20), 5×blaze_rod(40)=200=4×emerald(50), 10×sculk(15)=150=
// 3×diamond(50), 1×elytra(2000)=4×netherite_ingot(500). Re-check against
// FuValueRegistry after any rebalance rather than nudging these by feel.
const conversions = [
  { tier: 2, from: "3 copper ingots", to: "2 gold ingots" },
  { tier: 2, from: "4 end stone", to: "1 iron ingot" },
  { tier: 3, from: "5 redstone", to: "1 glowstone" },
  { tier: 4, from: "5 blaze rods", to: "4 emeralds" },
  { tier: 5, from: "10 sculk", to: "3 diamonds" },
  { tier: 6, from: "1 spare elytra", to: "4 netherite ingots" },
];
---
<Base>
  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Forge 1.20.1 · NeoForge 1.21.1–26.2 · Free &amp; open source</span>
        <h1>Wind anything.<br/><span class="grad">Print anything.</span></h1>
        <p class="lede">
          MC3DPrint turns matter into <strong>Filament Units</strong>, and filament
          back into matter. Wind copper, print gold. Wind sculk, print diamonds.
          Scan a whole castle and print that too. No creative mode, no commands.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/getting-started#download">Download the mod</a>
          <a class="btn btn-ghost" href="/guide">Read the guide</a>
        </div>
        <p class="muted small">WorldEdit for survival · MIT licensed · No paywalls, ever.</p>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-card">
          <div class="art-rows">
            {Array.from({ length: 6 }).map((_, r) => (
              <div class="art-row" style={`--d:${r * 0.12}s`}>
                {Array.from({ length: 6 }).map(() => <span class="vox"></span>)}
              </div>
            ))}
          </div>
          <div class="art-beam"></div>
          <p class="art-label">printing&nbsp;·&nbsp;layer 4 / 6</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── FEATURES ───────────────────────── -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">What it does</span>
      <h2>Every material is the same material.</h2>
      <div class="grid feat-grid">
        {features.map((f) => (
          <article class="card feat">
            <div class="feat-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── CONVERSIONS ───────────────────────── -->
  <section class="section conv">
    <div class="wrap">
      <span class="eyebrow">The exchange rate</span>
      <h2>Wind the thing you have. Print the thing you want.</h2>
      <p class="lede">
        Filament Units are denominated by <strong>tier</strong>, not by item. Wind a
        material and you get filament at that material's tier; spend it and you can
        print anything at that tier or below. So within a tier, matter is
        interchangeable.
      </p>

      <div class="conv-table" role="table" aria-label="Example material conversions">
        <div class="conv-head" role="row">
          <span role="columnheader">Wind this</span>
          <span role="columnheader" class="conv-arrow-h" aria-hidden="true"></span>
          <span role="columnheader">Print this</span>
          <span role="columnheader">Tier</span>
        </div>
        {conversions.map((c) => (
          <div class="conv-row" role="row">
            <span class="conv-from" role="cell">{c.from}</span>
            <span class="conv-arrow" role="cell" aria-label="becomes">→</span>
            <span class="conv-to" role="cell">{c.to}</span>
            <span class="conv-tier" role="cell" style={`color:var(--t${c.tier})`}>T{c.tier}</span>
          </div>
        ))}
      </div>

      <p class="muted conv-note">
        Ratios shown at exact break-even, which takes four Efficiency modules and so a
        <strong>Tier 4 or higher</strong> printer, since upgrade slots scale with tier.
        Below that you always pay a markup, so printing costs a little
        <em>more</em> than the matter is worth. That markup is the reason this can
        never become a duplication exploit: filament spends downward, never up, and
        winding is strictly exact-tier.
      </p>
      <p class="center" style="margin-top:1.6rem">
        <a class="btn btn-ghost" href="/guide/item-mode/">How Item Mode works →</a>
      </p>
    </div>
  </section>

  <!-- ───────────────────────── HOW IT WORKS ───────────────────────── -->
  <section class="section how">
    <div class="wrap">
      <span class="eyebrow">How it works</span>
      <h2>Three steps, start to finish.</h2>
      <div class="grid step-grid">
        {steps.map((s) => (
          <div class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
      <p class="center" style="margin-top:2rem">
        <a class="btn btn-ghost" href="/guide">See the full walkthrough →</a>
      </p>
    </div>
  </section>

  <!-- ───────────────────────── SEE IT IN ACTION ───────────────────────── -->
  <section class="section see">
    <div class="wrap">
      <span class="eyebrow">See it in action</span>
      <h2>Layer by layer, exactly as scanned.</h2>
      <p class="lede">Feed the printer power and a filament spool, drop in the disc, and your
        build reconstructs in place, every block state and connection intact.</p>

      <figure class="media-frame">
        <img class="media-real" src="/media/scan-to-print.gif"
             alt="A build printing block by block in Minecraft" loading="lazy"
             onerror="this.remove()" />
        <div class="media-fallback">
          <div class="mf-blueprint" aria-hidden="true"></div>
          <div class="mf-body">
            <h3>Preview any build in 3D</h3>
            <p class="muted">Spin, zoom, and inspect every curated blueprint right in your
              browser, no install required.</p>
            <a class="btn btn-primary" href="/viewer/" target="_blank" rel="noopener noreferrer">Open the 3D viewer ↗</a>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- ───────────────────────── FEATURED BUILDS ───────────────────────── -->
  <section class="section feat-builds">
    <div class="wrap">
      <div class="fb-head">
        <div>
          <span class="eyebrow">From the library</span>
          <h2 id="fb-title">Builds ready to print.</h2>
        </div>
        <a class="btn btn-ghost" href="/gallery">Browse the gallery →</a>
      </div>
      <div class="tier-ramp fb-ramp" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
      <div id="fb-grid" class="grid fb-grid"></div>
    </div>
  </section>

  <!-- ───────────────────────── COMMUNITY CTA ───────────────────────── -->
  <section class="section">
    <div class="wrap cta-band">
      <div>
        <span class="eyebrow">For the community</span>
        <h2>Built something great? Add it to the mod.</h2>
        <p class="lede">
          Drag in your <code>.blueprint</code> file, preview it in 3D right in your
          browser, and submit it for review: <strong>no GitHub account, no coding
          required.</strong> If it's a fit, it ships with the mod for everyone.
        </p>
        <a class="btn btn-primary" href="/submit">Submit your build</a>
      </div>
    </div>
  </section>

  <script>
    // Featured strip: pull the curated manifest the gallery uses and show a
    // tier-spanning sample. Each card prefers a real photo (/builds/<id>.png)
    // and falls back to a tier-tinted card glyph when none exists yet.
    const tierColor = (t) =>
      getComputedStyle(document.documentElement).getPropertyValue(`--t${t}`).trim() || "#9aa3ad";

    fetch("/viewer/manifest.json")
      .then((r) => { if (!r.ok) throw new Error(); return r.json(); })
      .then((m) => {
        const builds = m.builds || [];
        const base = m.base || "blueprints/";
        const grid = document.getElementById("fb-grid");
        const title = document.getElementById("fb-title");
        if (!builds.length) return;
        title.textContent = `${builds.length} builds ready to print.`;

        // Widest tier coverage: biggest build per tier, then fill to 8 by size.
        const byTier = new Map();
        for (const b of builds) {
          const cur = byTier.get(b.tier);
          if (!cur || b.blocks > cur.blocks) byTier.set(b.tier, b);
        }
        let featured = [...byTier.values()].sort((a, b) => a.tier - b.tier);
        if (featured.length < 8) {
          const have = new Set(featured.map((b) => b.file));
          featured = featured.concat(
            builds.filter((b) => !have.has(b.file)).sort((a, b) => b.blocks - a.blocks)
          );
        }
        featured = featured.slice(0, 8);

        for (const b of featured) {
          const id = b.file.replace(/\.blueprint$/, "");
          const src = new URL(base + b.file, location.origin + "/viewer/").pathname;
          const tc = tierColor(b.tier);
          const a = document.createElement("a");
          a.className = "card fb-card";
          a.href = `/viewer/?src=${encodeURIComponent(src)}`;
          a.target = "_blank";
          a.rel = "noopener noreferrer";
          a.innerHTML = `
            <div class="fb-shot" style="--tc:${tc}">
              <img src="/builds/${id}.png" alt="" loading="lazy" onerror="this.remove()" />
              <span class="fb-glyph" aria-hidden="true">▦</span>
            </div>
            <div class="fb-meta">
              <span class="tier" style="color:${tc}">T${b.tier}</span>
              <h3>${b.name}</h3>
              <span class="dims muted">${b.sx}×${b.sy}×${b.sz} · ${b.blocks.toLocaleString()} blocks</span>
            </div>`;
          grid.appendChild(a);
        }
      })
      .catch(() => {
        // Manifest only exists on the deployed site; hide the strip locally.
        document.querySelector(".feat-builds")?.setAttribute("hidden", "");
      });
  </script>
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 5vw, 4rem); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
  .hero-copy h1 { margin: 0.6rem 0 1rem; }
  .grad {
    background: linear-gradient(100deg, var(--filament-hi), var(--cyan-hi));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.6rem 0 0.9rem; }
  .small { font-size: 0.85rem; }

  /* hero art: a "printing" animation, pure CSS. Layers print bottom-up:
     each voxel starts as a cyan "ghost" (not-yet-printed), then pops to a
     solid amber-edged block as the scan head sweeps past it. Staggering the
     animation-delay by row makes the print front climb the stack in a wave. */
  .hero-art { display: flex; justify-content: center; }
  .art-card {
    --cyc: 4.4s;
    position: relative; width: min(360px, 80vw); aspect-ratio: 1;
    background:
      radial-gradient(130% 120% at 50% 110%, rgba(244,162,60,0.10), transparent 55%),
      radial-gradient(120% 120% at 50% 8%, var(--panel), var(--bg-soft));
    border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); overflow: hidden;
    display: grid; place-items: center;
  }
  /* faint machined baseplate the print sits on */
  .art-card::after {
    content: ""; position: absolute; left: 14%; right: 14%; bottom: 13%; height: 8px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--steel-4), #2a2f3a);
    box-shadow: 0 6px 18px rgba(0,0,0,0.5);
  }
  .art-rows { display: flex; flex-direction: column-reverse; gap: 6px; position: relative; z-index: 1; }
  .art-row { display: flex; gap: 6px; }
  .vox {
    width: 38px; height: 38px; border-radius: 4px;
    background: linear-gradient(160deg, var(--panel-2), #0e1017);
    border: 1px solid var(--line);
    animation: printin var(--cyc) ease-in-out infinite; animation-delay: var(--d);
    will-change: opacity, transform;
  }
  @keyframes printin {
    0%   { opacity: 0.22; transform: translateY(6px) scale(0.92);
           border-color: color-mix(in srgb, var(--cyan) 45%, var(--line));
           box-shadow: 0 0 0 rgba(244,162,60,0); }
    11%  { opacity: 1; transform: translateY(0) scale(1);
           border-color: var(--filament);
           box-shadow: 0 0 16px rgba(244,162,60,0.5); }
    22%  { border-color: color-mix(in srgb, var(--filament) 55%, var(--line));
           box-shadow: 0 0 5px rgba(244,162,60,0.22); }
    86%  { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0.22; transform: translateY(6px) scale(0.92);
           border-color: color-mix(in srgb, var(--cyan) 45%, var(--line)); }
  }
  .art-beam {
    position: absolute; left: 9%; right: 9%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--filament-hi), transparent);
    box-shadow: 0 0 16px 3px rgba(244, 162, 60, 0.55);
    animation: scan var(--cyc) ease-in-out infinite;
  }
  @keyframes scan {
    0%   { top: 78%; opacity: 0.12; }
    11%  { opacity: 1; }
    86%  { top: 22%; opacity: 0.95; }
    100% { top: 19%; opacity: 0; }
  }
  .art-label {
    position: absolute; bottom: 12px; right: 14px; margin: 0;
    font-family: var(--mono); font-size: 0.72rem; color: var(--filament); letter-spacing: 0.04em;
  }

  /* features */
  .feat-grid { grid-template-columns: repeat(3, 1fr); margin-top: 1.8rem; }
  .feat-icon { font-size: 1.6rem; margin-bottom: 0.5rem; }
  .feat h3 { margin: 0 0 0.4rem; }
  .feat p { margin: 0; font-size: 0.95rem; }

  /* conversions */
  .conv .lede { max-width: 62ch; margin-block: 0.8rem 0; }
  .conv-table {
    margin-top: 1.8rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--panel);
  }
  .conv-head, .conv-row {
    display: grid; grid-template-columns: 1fr 2.5rem 1fr 4rem;
    align-items: center; gap: 0.5rem;
    padding: 0.85rem clamp(0.9rem, 2vw, 1.4rem);
  }
  .conv-head {
    background: var(--bg-soft); border-bottom: 1px solid var(--line);
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .conv-row + .conv-row { border-top: 1px solid var(--line-soft); }
  .conv-row { transition: background 0.12s ease; }
  .conv-row:hover { background: var(--bg-soft); }
  .conv-from { color: var(--ink-soft); }
  .conv-to { color: var(--ink); font-weight: 600; }
  .conv-arrow { color: var(--filament); font-size: 1.1rem; text-align: center; }
  .conv-tier { font-family: var(--mono); font-weight: 700; font-size: 0.82rem; text-align: right; }
  .conv-note { margin-top: 1.1rem; font-size: 0.9rem; max-width: 68ch; }

  /* steps */
  .how { background: var(--bg-soft); border-block: 1px solid var(--line-soft); }
  .step-grid { grid-template-columns: repeat(3, 1fr); margin-top: 1.8rem; }
  .step-n { font-family: var(--mono); font-size: 1.4rem; color: var(--filament); font-weight: 700; }
  .step h3 { margin: 0.4rem 0; }
  .step p { margin: 0; }

  /* cta */
  .cta-band {
    background: linear-gradient(120deg, rgba(244,162,60,0.10), rgba(92,200,255,0.09));
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(1.6rem, 4vw, 2.8rem);
  }
  .cta-band .lede { margin-block: 0.8rem 1.4rem; }

  /* see it in action */
  .media-frame {
    position: relative; margin: 1.8rem 0 0; aspect-ratio: 16 / 9;
    border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--bg-soft);
  }
  .media-real { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 2; }
  .media-fallback {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: 1.05fr 1fr; align-items: stretch;
  }
  .mf-blueprint {
    position: relative; height: 100%;
    border-right: 1px solid var(--line);
    background:
      linear-gradient(0deg, rgba(92,200,255,0.10), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 27px, rgba(92,200,255,0.10) 27px 28px),
      repeating-linear-gradient(90deg, transparent 0 27px, rgba(92,200,255,0.10) 27px 28px),
      var(--bg);
  }
  .mf-blueprint::after {
    content: ""; position: absolute; inset: 30% 32%;
    background: linear-gradient(160deg, rgba(244,162,60,0.28), rgba(244,162,60,0.05));
    border: 1px solid rgba(244,162,60,0.55); border-radius: 4px;
    box-shadow: 0 0 26px rgba(244,162,60,0.25), inset 0 0 0 6px rgba(12,13,18,0.4);
  }
  .mf-body { padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 0.4rem; }
  .mf-body h3 { margin: 0; }
  .mf-body p { margin: 0 0 0.6rem; font-size: 0.95rem; }

  /* featured builds */
  .feat-builds[hidden] { display: none; }
  .fb-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .fb-head h2 { margin: 0.3rem 0 0; }
  .fb-ramp { margin: 1rem 0 1.6rem; max-width: 300px; }
  .fb-grid { grid-template-columns: repeat(4, 1fr); }
  .fb-card { padding: 0; overflow: hidden; transition: transform 0.1s ease, border-color 0.15s ease; }
  .fb-card:hover { transform: translateY(-3px); border-color: var(--filament); text-decoration: none; }
  .fb-shot {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden;
    display: grid; place-items: center;
    background: linear-gradient(160deg, color-mix(in srgb, var(--tc) 22%, var(--panel)), var(--bg-soft));
  }
  .fb-shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .fb-glyph { font-size: 2rem; color: color-mix(in srgb, var(--tc) 70%, var(--ink-faint)); opacity: 0.55; }
  .fb-meta { padding: 0.8rem 1rem 1rem; }
  .fb-meta .tier { font-family: var(--mono); font-weight: 700; font-size: 0.78rem; }
  .fb-meta h3 { margin: 0.2rem 0; font-size: 1rem; }
  .fb-meta .dims { font-size: 0.8rem; }

  @media (max-width: 980px) {
    .fb-grid { grid-template-columns: repeat(2, 1fr); }
    .media-fallback { grid-template-columns: 1fr; }
    .mf-blueprint { display: none; }
  }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { order: -1; }
    .feat-grid, .step-grid { grid-template-columns: 1fr; }
    /* Tier chip moves under the pair so the from→to reading order survives. The header
       row is hidden VISUALLY only: display:none would drop the sole columnheader
       elements out of the ARIA table and leave screen readers without column context. */
    .conv-head {
      position: absolute; width: 1px; height: 1px;
      margin: -1px; padding: 0; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
    .conv-row { grid-template-columns: 1fr 2rem 1fr; padding-block: 0.95rem; }
    .conv-tier { grid-column: 1 / -1; text-align: left; font-size: 0.74rem; }
  }
  @media (max-width: 520px) { .fb-grid { grid-template-columns: 1fr; } }
</style>

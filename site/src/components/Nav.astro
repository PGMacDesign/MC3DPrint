---
const links = [
  { href: "/getting-started", label: "Get Started" },
  { href: "/guide",           label: "Guide" },
  { href: "/gallery",         label: "Gallery" },
  { href: "/viewer/",         label: "Viewer" },
  { href: "/submit",          label: "Submit a Build" },
  { href: "/about",           label: "About" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <img class="brand-mark" src="/brand/logo.svg" alt="" width="28" height="28" aria-hidden="true" />
      MC3DPrint
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          class={path === l.href.replace(/\/$/, "") ? "active" : ""}
          target={l.href.startsWith("/viewer") ? "_blank" : undefined}
          rel={l.href.startsWith("/viewer") ? "noopener noreferrer" : undefined}
        >{l.label}</a>
      ))}
      <a class="btn btn-primary nav-cta" href="/getting-started#download">Download</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    color: var(--ink); font-weight: 750; font-size: 1.1rem; letter-spacing: -0.02em;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    width: 28px; height: 28px; border-radius: 6px;
    display: block;
    box-shadow: 0 0 14px rgba(92, 200, 255, 0.28);
  }
  .nav-links { display: flex; align-items: center; gap: 1.4rem; }
  .nav-links a { color: var(--ink-soft); font-size: 0.95rem; font-weight: 500; }
  .nav-links a:hover { color: var(--ink); text-decoration: none; }
  .nav-links a.active { color: var(--filament-hi); }
  .nav-cta { color: #1a1205 !important; }

  .nav-burger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .nav-burger span { width: 22px; height: 2px; background: var(--ink); border-radius: 2px; }

  @media (max-width: 820px) {
    .nav-burger { display: flex; }
    .nav-links {
      position: absolute; top: 64px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--panel); border-bottom: 1px solid var(--line);
      padding: 0.5rem var(--gutter) 1rem;
      display: none;
    }
    .nav-links a { padding: 0.7rem 0; border-bottom: 1px solid var(--line-soft); }
    .nav-toggle:checked ~ .nav-links { display: flex; }
    .nav-cta { margin-top: 0.6rem; justify-content: center; }
  }
</style>
